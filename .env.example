# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Storage
UPLOAD_DIR=./uploads

# Database (TypeORM)
# 'sqlite' for local dev, 'postgres' for production
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/skydrift.sqlite

# Production Postgres (Ignored when DB_TYPE=sqlite)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Open-Source / AI Credentials
# Get free key from aistudio.google.com
GEMMA_API_KEY=your_gemma_api_key_here
# Get free key from elevenlabs.io (or leave blank to use fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM